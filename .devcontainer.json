{
  "name": "AyuGram Desktop - Rocky Linux 8",
  "build": {
    "dockerfile": ".devcontainer/Dockerfile",
    "context": "."
  },
  "remoteUser": "user",
  "containerUser": "user",
  "updateRemoteUserUID": false,
  "shutdownAction": "stopContainer",
  "overrideCommand": false,
  "hostRequirements": {
    "cpus": 16,
    "memory": "24gb",
    "storage": "100gb"
  },
  "runArgs": [
    "--init",
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges=true",
    "--read-only",
    "--pids-limit=4096",
    "--cpus=16",
    "--memory=24g",
    "--memory-swap=32g",
    "--shm-size=2g",
    "--tmpfs=/tmp:rw,nosuid,size=4g",
    "--tmpfs=/run:rw,noexec,nosuid,size=64m",
    "--tmpfs=/var/tmp:rw,noexec,nosuid,size=1g"
  ],
  "mounts": ["source=ayugram-dev-home,target=/home/user,type=volume"],
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "AyuGram Linux Desktop",
      "onAutoForward": "openBrowser",
      "requireLocalPort": true
    }
  },
  "containerEnv": {
    "CMAKE_BUILD_PARALLEL_LEVEL": "16",
    "XDG_CACHE_HOME": "/home/user/.cache",
    "XDG_RUNTIME_DIR": "/home/user/.local/run",
    "DISPLAY": ":1",
    "QT_QPA_PLATFORM": "xcb",
    "QT_X11_NO_MITSHM": "1",
    "LIBGL_ALWAYS_SOFTWARE": "1"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "C_Cpp.intelliSenseEngine": "disabled",
        "cmake.configureOnOpen": false,
        "cmake.configureOnEdit": false,
        "clangd.arguments": [
          "--background-index",
          "--compile-commands-dir=${workspaceFolder}",
          "--header-insertion=never",
          "--pch-storage=memory",
          "--limit-results=100",
          "--limit-references=1000"
        ],
        "cmake.generator": "Ninja Multi-Config",
        "cmake.buildDirectory": "/home/user/out",
        "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json"
      },
      "extensions": [
        "ms-vscode.cpptools",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "theqtcompany.qt",
        "ms-python.python",
        "redhat.vscode-yaml"
      ]
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/usr/src/tdesktop,type=bind,consistency=cached",
  "workspaceFolder": "/usr/src/tdesktop"
}
